# ── Hindsight (Vectorize) ─────────────────────────────────────────────────────
# Get from: https://ui.hindsight.vectorize.io → Settings → API Keys
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Pipeline IDs for each deal bank
# Get from: https://ui.hindsight.vectorize.io → Pipelines
HINDSIGHT_PIPELINE_ID_ACME=your_acme_pipeline_uuid_here
HINDSIGHT_PIPELINE_ID_NOVATECH=your_novatech_pipeline_uuid_here

# ── Groq LLM ─────────────────────────────────────────────────────────────────
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dealmind?retryWrites=true&w=majority

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
# Set to your Vercel deployment URL in production
FRONTEND_URL=https://your-app.vercel.app
