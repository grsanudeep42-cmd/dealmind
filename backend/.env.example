# Hindsight (Vectorize) — https://ui.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_PIPELINE_ID_ACME=your_acme_pipeline_uuid_here
HINDSIGHT_PIPELINE_ID_NOVATECH=your_novatech_pipeline_uuid_here

# Groq LLM — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dealmind

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.vercel.app
